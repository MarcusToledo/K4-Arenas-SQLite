<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <PublishDir>./bin/K4-Arenas/plugins/K4-Arenas/</PublishDir>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Needed so `dotnet publish` copies the native SQLite libraries (runtimes/<rid>/native) required by Microsoft.Data.Sqlite. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="*">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Dapper" Version="*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="*" />
    <!-- Microsoft.Data.Sqlite still pulls SQLitePCLRaw.bundle_e_sqlite3 2.1.11, which bundles a SQLite
         build affected by GHSA-2m69-gcr7-jv3q (memory corruption, fixed in SQLite 3.50.2+). Pin the
         transitive dependency up to force the patched native library. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <ProjectReference Include="../src-shared/K4-ArenaSharedApi.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- Place your local copy of KitsuneMenu.dll under src-plugin/libs/ (see libs/README.md). -->
    <Reference Include="KitsuneMenu">
      <HintPath>libs\KitsuneMenu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyCustomFilesToPublishDirectory" AfterTargets="Publish">
    <Copy SourceFiles="$(ProjectDir)readme.txt" DestinationFolder="$(PublishDir)\" />
    <Copy SourceFiles="$(ProjectDir)/../src-shared/K4-ArenaSharedApi.dll" DestinationFolder="$(PublishDir)../../shared/K4-ArenaSharedApi/" />
    <Copy SourceFiles="$(ProjectDir)libs\KitsuneMenu.dll" DestinationFolder="$(PublishDir)../../shared/KitsuneMenu/" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
    <!--
      CounterStrikeSharp loads plugin DLLs directly from the plugin folder, not through a normal
      `dotnet exec` host, so it does not probe the `runtimes/<rid>/native` subfolder that a portable
      publish produces. Flatten the native SQLite library next to the plugin DLL so Microsoft.Data.Sqlite
      can find it at runtime. If this file is missing after publish, copy it manually next to K4-Arenas.dll.
    -->
    <Copy SourceFiles="$(PublishDir)runtimes/linux-x64/native/libe_sqlite3.so" DestinationFolder="$(PublishDir)\" Condition="Exists('$(PublishDir)runtimes/linux-x64/native/libe_sqlite3.so')" />
    <Copy SourceFiles="$(PublishDir)runtimes/win-x64/native/e_sqlite3.dll" DestinationFolder="$(PublishDir)\" Condition="Exists('$(PublishDir)runtimes/win-x64/native/e_sqlite3.dll')" />
  </Target>
</Project>