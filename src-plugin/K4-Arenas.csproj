<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <!--
      Needs to stay enabled now that the plugin ships a native dependency (Microsoft.Data.Sqlite).
      With GenerateDependencyFile=false, a framework-dependent RID-specific `dotnet publish -r <rid>`
      silently stops copying runtimes/<rid>/native/* into the publish output entirely, which is what
      left SqliteConnection unable to find libe_sqlite3.so at runtime.
    -->
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <PublishDir>./bin/K4-Arenas/plugins/K4-Arenas/</PublishDir>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Needed so `dotnet publish` copies the native SQLite libraries (runtimes/<rid>/native) required by Microsoft.Data.Sqlite. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="*">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Dapper" Version="*" />
    <!--
      Microsoft.Data.Sqlite pulls SQLitePCLRaw.bundle_e_sqlite3 2.1.11, whose bundled SQLite is
      affected by GHSA-2m69-gcr7-jv3q (memory corruption in queries with more aggregate terms than
      columns). We deliberately do NOT pin this up: every version with the fix (2.1.12+) ships a
      linux-x64 libe_sqlite3.so linked against GLIBC_2.33+, which broke loading on the target server
      (older glibc). This plugin only ever runs simple parameterized CRUD with no aggregates and no
      externally-supplied SQL, so the advisory doesn't practically apply here — compatibility wins.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="*" />
    <ProjectReference Include="../src-shared/K4-ArenaSharedApi.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- Place your local copy of KitsuneMenu.dll under src-plugin/libs/ (see libs/README.md). -->
    <Reference Include="KitsuneMenu">
      <HintPath>libs\KitsuneMenu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyCustomFilesToPublishDirectory" AfterTargets="Publish">
    <Copy SourceFiles="$(ProjectDir)readme.txt" DestinationFolder="$(PublishDir)\" />
    <Copy SourceFiles="$(ProjectDir)/../src-shared/K4-ArenaSharedApi.dll" DestinationFolder="$(PublishDir)../../shared/K4-ArenaSharedApi/" />
    <Copy SourceFiles="$(ProjectDir)libs\KitsuneMenu.dll" DestinationFolder="$(PublishDir)../../shared/KitsuneMenu/" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
    <!--
      Redundant safety net: with GenerateDependencyFile enabled above, the SDK already copies
      runtimes/<rid>/native/* into the publish output and CounterStrikeSharp's loader resolves it
      from there via K4-Arenas.deps.json (confirmed working elsewhere with the same pattern). Also
      drop a flattened copy next to the DLL in case that resolution ever falls back to it.
    -->
    <Copy SourceFiles="$(PublishDir)runtimes/linux-x64/native/libe_sqlite3.so" DestinationFolder="$(PublishDir)\" Condition="Exists('$(PublishDir)runtimes/linux-x64/native/libe_sqlite3.so')" />
    <Copy SourceFiles="$(PublishDir)runtimes/win-x64/native/e_sqlite3.dll" DestinationFolder="$(PublishDir)\" Condition="Exists('$(PublishDir)runtimes/win-x64/native/e_sqlite3.dll')" />
  </Target>
</Project>